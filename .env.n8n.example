# Copy to .env.n8n (git-ignored) or run ./scripts/setup-secrets.sh to generate it.

# Encrypts credentials stored in n8n's database. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Shared HMAC secrets — must match the values set on the Convex deployment.
# Convex -> n8n (n8n verifies):
LENDLOOP_TO_N8N_SECRET=
# n8n -> Convex (n8n signs):
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions URL as seen from inside the n8n container.
#  - local Convex backend:  http://host.docker.internal:3211
#  - Convex cloud:          https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Used for links in emails.
LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>
# Email provider. Unset = Mailpit's send API (local). Production: brevo
# (the Brevo API key goes in the n8n "LendLoop Mail API" credential, not here).
# LENDLOOP_MAIL_API=brevo
# Receives "workflow failed" alerts from the error workflow.
LENDLOOP_OPS_EMAIL=ops@lendloop.local
