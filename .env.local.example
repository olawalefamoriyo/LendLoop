# Next.js (copy to .env.local). `npx convex dev` fills in the Convex values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: Dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Convex deployment env vars are NOT read from this file. Set them with
# `npx convex env set NAME value` (or ./scripts/setup-secrets.sh):
#
#   CLERK_JWT_ISSUER_DOMAIN       Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
#   ADMIN_EMAILS                  Comma-separated verified emails that become admins on sign-in
#   N8N_LOAN_EVENTS_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop-loan-events
#   LENDLOOP_TO_N8N_SECRET        HMAC secret, Convex -> n8n
#   N8N_TO_LENDLOOP_SECRET        HMAC secret, n8n -> Convex
# ---------------------------------------------------------------------------
