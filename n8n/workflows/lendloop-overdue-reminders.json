{
  "id": "LLOverdueRemind1",
  "name": "LendLoop · Overdue reminders",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "19c41885-6bb8-48d4-a509-ec7639d4b688",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "54b28adb-bab2-4d9e-af8e-856a88ae2326",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// The execution id doubles as the lease owner on the LendLoop side.\nreturn [{ json: { payload: { runId: String($execution.id) } } }];"
      },
      "id": "b8c8063e-99a3-4d8b-a4ce-e44fcdb46463",
      "name": "Build fetch request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign each outgoing payload for LendLoop (HMAC-SHA256 over \"<timestamp>.<body>\").\n// The secret comes from the n8n environment, never from the workflow JSON.\nconst crypto = require('crypto');\nconst secret = $env.N8N_TO_LENDLOOP_SECRET;\nif (!secret) throw new Error('N8N_TO_LENDLOOP_SECRET is not configured');\n\nreturn $input.all().map((item) => {\n  const body = JSON.stringify(item.json.payload);\n  const timestamp = String(Date.now());\n  const signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n  return { json: { body, timestamp, signature }, pairedItem: item.pairedItem };\n});"
      },
      "id": "76ede6ec-703a-4bdf-a63a-0239773fc93f",
      "name": "Sign fetch request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "ea53d3cb-6f8c-4fd7-a9d0-866f4d0e8826",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "26fca00a-e3b0-48cc-a743-90f2427a75e7",
      "name": "One item per reminder",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst appUrl = $env.LENDLOOP_APP_URL || 'http://localhost:3000';\nconst due = new Date(r.dueDate + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });\nconst days = r.daysOverdue === 1 ? '1 day' : r.daysOverdue + ' days';\nreturn {\n  json: {\n    reminderKey: r.reminderKey,\n    to: r.recipient.email,\n    subject: '[LendLoop] Reminder: please return the ' + r.toolName,\n    text: 'Hi ' + r.recipient.firstName + ',\\n\\nThe ' + r.toolName + ' you borrowed from ' + r.lenderFirstName +\n      ' was due back on ' + due + ' (' + days + ' ago). Please arrange to return it soon.\\n\\n' +\n      'Your loans: ' + appUrl + '/requests\\n\\n— LendLoop',\n  },\n};"
      },
      "id": "571a5026-ad5f-4cc2-ab41-bd6d45085dbe",
      "name": "Compose reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.LENDLOOP_MAIL_FROM }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "e39f1e27-9a2e-42cc-a6c9-8ace4bb3be04",
      "name": "Send reminder email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "LLMailpitSmtp001",
          "name": "LendLoop SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    payload: {\n      reminderKey: $('Compose reminder').item.json.reminderKey,\n      status: 'sent',\n      executionId: String($execution.id),\n    },\n  },\n};"
      },
      "id": "965ef90a-6770-42ae-a380-2b1c01d125d1",
      "name": "Mark sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const err = $json.error;\nreturn {\n  json: {\n    payload: {\n      reminderKey: $('Compose reminder').item.json.reminderKey,\n      status: 'failed',\n      error: String((err && err.message) || err || 'Email delivery failed').slice(0, 300),\n      executionId: String($execution.id),\n    },\n  },\n};"
      },
      "id": "081b85b0-3bd8-4d70-aadf-d97fa7239aeb",
      "name": "Mark failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sign each outgoing payload for LendLoop (HMAC-SHA256 over \"<timestamp>.<body>\").\n// The secret comes from the n8n environment, never from the workflow JSON.\nconst crypto = require('crypto');\nconst secret = $env.N8N_TO_LENDLOOP_SECRET;\nif (!secret) throw new Error('N8N_TO_LENDLOOP_SECRET is not configured');\n\nreturn $input.all().map((item) => {\n  const body = JSON.stringify(item.json.payload);\n  const timestamp = String(Date.now());\n  const signature = 'sha256=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n  return { json: { body, timestamp, signature }, pairedItem: item.pairedItem };\n});"
      },
      "id": "7a9bb6d3-e88c-4f0e-a13e-ecbc5c9efc39",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminder-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "19f5658b-f9b8-4961-a223-2d9dac41423f",
      "name": "Write back reminder status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Build fetch request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run manually": {
      "main": [
        [
          {
            "node": "Build fetch request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build fetch request": {
      "main": [
        [
          {
            "node": "Sign fetch request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign fetch request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per reminder": {
      "main": [
        [
          {
            "node": "Compose reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose reminder": {
      "main": [
        [
          {
            "node": "Send reminder email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder email": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark sent": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark failed": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Write back reminder status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLErrorHandler01",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
